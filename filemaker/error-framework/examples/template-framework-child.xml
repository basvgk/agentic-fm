<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <Text>PURPOSE: Template child script using the standard response, error, logging, and trace framework.</Text>
  </Step>
  <Step enable="False" id="61" name="Insert Text">
    <SelectAll state="False"/>
    <Text>PARAMETERS: Business JSON supplied by Param.Make ( payload ).&#xD;&#xD;RETURNS: Response.Make ( $data ).&#xD;&#xD;Replace the disabled business-work note with this script's work. Create errors where they occur, then run the log script once after the main loop.</Text>
    <Field>$README</Field>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> ### STANDARD SCRIPT STARTUP ###</Text>
  </Step>
  <Step enable="True" id="85" name="Allow User Abort">
    <Set state="False"/>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Trace.Init]]></Calculation></Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Param.Payload]]></Calculation></Value>
    <Name>$payload</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA["Any data to return, plain text or JSON"]]></Calculation></Value>
    <Name>$resultData</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA["Any context relevant for the error logging. JSON format."]]></Calculation></Value>
    <Name>$context</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> ### ### ### ### ### ### ### ###</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> ### MAIN CHILD SCRIPT BODY ###</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Example fragment of script that creates an error and/or result</Text>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Do some work or checks that may create an error</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Check if the payload is valid JSON</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[not JSON.IsValid ( $payload )]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Something is wrong, create an error.</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA["Put context here, for example important variables. JSON format"]]></Calculation></Value>
    <Name>$context</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Error.Make ( "TEMPLATE.CHILD.INVALID_PARAMETER" ; "Template child received invalid JSON parameters." ; "The request could not be processed." ; $context )]]></Calculation></Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Exit the loop because there was an error.</Text>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[True]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Example creating a random result</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( $resultData ; "keyName" ; "exampleValue" ; JSONString )]]></Calculation></Value>
    <Name>$resultData</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>// # Continue script</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Always end loop with Exit Loop If 1 (single pass loop)</Text>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[True]]></Calculation>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> ### ### ### ### ### ### ### ###</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> ### CENTRALIZED ERROR LOGGING — ONCE AFTER THE LOOP ###</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[Error.HasError]]></Calculation>
  </Step>
  <Step enable="True" id="164" name="Perform Script on Server">
    <WaitForCompletion state="False"/>
    <Calculation><![CDATA[Error.Get]]></Calculation>
    <Script id="0" name="(94000) Creeer foutmelding"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Exit the script. Response.Make returns the error object automatically and the result data when the parent uses Response.Capture.</Text>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[Response.Make ( $resultData )]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text>========================================================================================================</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> MIGRATION VARIANT: Incremental adoption for existing scripts</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Use this pattern when refactoring an EXISTING script that has parent callers</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> not yet migrated to the framework. Keeps backward compatibility.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text>========================================================================================================</Text>
  </Step>
  <Step enable="False" id="61" name="Insert Text">
    <SelectAll state="False"/>
    <Text>MIGRATION VARIANT — Incremental Adoption&#xD;&#xD;PARAMETERS: Original format via Get(ScriptParameter) (active) + Param.Payload (disabled)&#xD;RETURNS: Original format via Exit Script[$return] (active) + Response.Make($data) (disabled)&#xD;&#xD;Rules applied:&#xD;- Keep Get(ScriptParameter) active; add Param.Payload as disabled step using same $payload var&#xD;- Keep original response format active; add Response.Make as disabled step&#xD;- Add disabled Response.Get* steps for future parent migration&#xD;- NEVER remove business logic steps (Commit Records, Set Field, etc.)&#xD;- Use If[FMError.Set] directly — no intermediate $r check&#xD;- $context stays as "{}"; framework auto-includes param/trace/native error&#xD;- Error codes: concise without script prefix (e.g., INVALID_PARAMETER)&#xD;- Prefixed codes only for child-script errors (e.g., PARENT.CHILD_ERROR)&#xD;&#xD;See agent/docs/knowledge/error-framework.md § "Incremental Migration of Existing Scripts"</Text>
    <Field>$README</Field>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> ### STANDARD SCRIPT STARTUP (Migration Variant) ###</Text>
  </Step>
  <Step enable="True" id="85" name="Allow User Abort">
    <Set state="False"/>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Trace.Init]]></Calculation></Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Get ( ScriptParameter )]]></Calculation></Value>
    <Name>$payload</Name>
  </Step>
  <Step enable="False" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Param.Payload]]></Calculation></Value>
    <Name>$payload</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[""]]></Calculation></Value>
    <Name>$data</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA["{}"]]></Calculation></Value>
    <Name>$context</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA["{}"]]></Calculation></Value>
    <Name>$return</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> ### ### ### ### ### ### ### ###</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> ### MAIN SCRIPT BODY (with business logic preserved) ###</Text>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Business logic step — Commit Records (PRESERVED, not removed)</Text>
  </Step>
  <Step enable="True" id="75" name="Commit Records/Requests">
    <NoInteract state="True"/>
    <Option state="False"/>
    <ESSForceCommit state="False"/>
    <DisableStepCollapsed state="False"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[FMError.Set]]></Calculation></Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[$r ≠ 0]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Error.Make ( "COMMIT_ERROR" ; "Failed to commit records." ; "Wijzigingen konden niet worden opgeslagen." ; $context )]]></Calculation></Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[True]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Validate input parameter</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONGetElement ( $payload ; "idOpdracht" )]]></Calculation></Value>
    <Name>$idOpdracht</Name>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[not JSON.IsValid ( $payload ) or IsEmpty ( $idOpdracht )]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Error.Make ( "INVALID_PARAMETER" ; "Invalid or missing idOpdracht parameter." ; "De opgegeven opdracht is ongeldig." ; $context )]]></Calculation></Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[True]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Business logic step — New Window (PRESERVED)</Text>
  </Step>
  <Step enable="True" id="122" name="New Window">
    <LayoutDestination value="SelectedLayout"/>
    <NewWndStyles DimParentWindow="No" Toolbars="No" MenuBar="No" Style="Document" Close="Yes" Minimize="Yes" Maximize="Yes" Resize="No" Styles="3221684226"/>
    <Layout id="0" name="LayoutName"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[FMError.Set]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Error.Make ( "WINDOW_ERROR" ; "Failed to open window." ; "Kon venster niet openen." ; $context )]]></Calculation></Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[True]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Business logic step — Perform Find (PRESERVED)</Text>
  </Step>
  <Step enable="True" id="28" name="Perform Find">
    <Restore state="True"/>
    <Query>
      <RequestRow operation="Include">
        <Criteria>
          <Field table="TABLE" id="0" name="id"/>
          <Text>$idOpdracht</Text>
        </Criteria>
      </RequestRow>
    </Query>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[FMError.Set]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Error.Make ( "FIND_ERROR" ; "Perform Find failed." ; "Zoeken mislukt." ; $context )]]></Calculation></Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[True]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Business logic step — Set Field (PRESERVED)</Text>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[Some::Calculation]]></Calculation>
    <Field table="TABLE" id="0" name="FieldName"/>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[FMError.Set]]></Calculation>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Error.Make ( "SET_FIELD_ERROR" ; "Failed to set field." ; "Kon veld niet bijwerken." ; $context )]]></Calculation></Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[True]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Success — set result data for both formats</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[JSONSetElement ( $return ; [ "success" ; True ; JSONBoolean ] ; [ "idOpdracht" ; $idOpdracht ; JSONString ] ; [ "error.code" ; 0 ; JSONNumber ] )]]></Calculation></Value>
    <Name>$return</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Always end loop with Exit Loop If 1 (single pass loop)</Text>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <Calculation><![CDATA[True]]></Calculation>
  </Step>
  <Step enable="True" id="73" name="End Loop"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> ### CENTRALIZED ERROR LOGGING — ONCE AFTER THE LOOP ###</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <Calculation><![CDATA[Error.HasError]]></Calculation>
  </Step>
  <Step enable="True" id="164" name="Perform Script on Server">
    <WaitForCompletion state="False"/>
    <Calculation><![CDATA[Error.Get]]></Calculation>
    <Script id="0" name="SYS_LogError"/>
  </Step>
  <Step enable="True" id="70" name="End If"/>
  <Step enable="True" id="89" name="# (comment)"/>
  <Step enable="True" id="89" name="# (comment)">
    <Text> Exit with ORIGINAL response format (active for backward compatibility)</Text>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <Calculation><![CDATA[$return]]></Calculation>
  </Step>
  <Step enable="False" id="103" name="Exit Script">
    <Calculation><![CDATA[Response.Make ( $data )]]></Calculation>
  </Step>
  <Step enable="False" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Response.GetData]]></Calculation></Value>
    <Name>$childData</Name>
  </Step>
  <Step enable="False" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Response.GetErrorCode]]></Calculation></Value>
    <Name>$childErrorCode</Name>
  </Step>
  <Step enable="False" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Response.GetErrorMessage]]></Calculation></Value>
    <Name>$childErrorMessage</Name>
  </Step>
  <Step enable="False" id="141" name="Set Variable">
    <Value><Calculation><![CDATA[Response.GetErrorUserMessage]]></Calculation></Value>
    <Name>$childErrorUserMessage</Name>
  </Step>
</fmxmlsnippet>
