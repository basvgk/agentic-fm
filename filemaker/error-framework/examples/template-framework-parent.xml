<?xml version="1.0" encoding="UTF-8"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text>STANDARD HEADER ACCORDING TO CONDING CONVENTIONS AT TOP.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> ### STANDARD SCRIPT STARTUP ###</Text>
  </Step>
  <Step enable="True" id="85" name="Allow User Abort">
    <Set state="False"/>
    <DisableStepCollapsed state="False"/>
  </Step>
  <Step enable="True" id="86" name="Set Error Capture">
    <Set state="True"/>
    <DisableStepCollapsed state="False"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <DisableStepCollapsed state="False"/>
    <Value>
      <Calculation><![CDATA[Trace.Init]]></Calculation>
    </Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <DisableStepCollapsed state="False"/>
    <Value>
      <Calculation><![CDATA[Param.Payload]]></Calculation>
    </Value>
    <Name>$payload</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <DisableStepCollapsed state="False"/>
    <Value>
      <Calculation><![CDATA["Any data to return, plain text or JSON"]]></Calculation>
    </Value>
    <Name>$resultData</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <DisableStepCollapsed state="False"/>
    <Value>
      <Calculation><![CDATA["Any context relevant for the error logging. JSON format."]]></Calculation>
    </Value>
    <Name>$context</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> ### ### ### ### ### ### ### ###</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> ### CHILD CALL AND ERROR HANDLING ###</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> Use a loop as a filemaker try-catch alternative</Text>
  </Step>
  <Step enable="True" id="71" name="Loop">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> Specify the script payload in JSON format</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <DisableStepCollapsed state="False"/>
    <Value>
      <Calculation><![CDATA[""]]></Calculation>
    </Value>
    <Name>$childPayload</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> Perform the script. Pass parameter using the Param.Make function, which also includes the Trace variable.</Text>
  </Step>
  <Step enable="True" id="1" name="Perform Script">
    <DisableStepCollapsed state="False"/>
    <Calculation><![CDATA[Param.Make ( $childPayload )]]></Calculation>
    <Script id="920" name="Playground"/>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <DisableStepCollapsed state="False"/>
    <Value>
      <Calculation><![CDATA[Response.Capture]]></Calculation>
    </Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> Child script must return the result and error details in correct format (using the Response.Make function). Capture response using Response.Capture.</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> Check if the script gave an error</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Calculation><![CDATA[not Response.IsOK]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> Isolate the error code</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <DisableStepCollapsed state="False"/>
    <Value>
      <Calculation><![CDATA[Response.GetErrorCode]]></Calculation>
    </Value>
    <Name>$childErrorCode</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> Do specific logic depending on the error code. Multiple ifs or case statement also possible.</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Calculation><![CDATA[$childErrorCode = "SOME.CODE.TO.CHECK"]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text>&lt;&lt; Do something here &gt;&gt;</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> If required, create a new, breaking error in this script as well and exit the script execution (preferably using the Exit loop if step).</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <DisableStepCollapsed state="False"/>
    <Value>
      <Calculation><![CDATA["Put JSON context here, for example important variables."]]></Calculation>
    </Value>
    <Name>$context</Name>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <DisableStepCollapsed state="False"/>
    <Value>
      <Calculation><![CDATA[Error.Make ( "CUSTOM.ERROR.CODE" ; "ErrorMessage" ; "MessageForUser" ; $context )]]></Calculation>
    </Value>
    <Name>$r</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> Exit the loop because there was an error.</Text>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <DisableStepCollapsed state="False"/>
    <Calculation><![CDATA[1]]></Calculation>
  </Step>
  <Step enable="True" id="70" name="End If">
    <DisableStepCollapsed state="False"/>
  </Step>
  <Step enable="True" id="70" name="End If">
    <DisableStepCollapsed state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> Process or do something with the child script results</Text>
  </Step>
  <Step enable="True" id="141" name="Set Variable">
    <DisableStepCollapsed state="False"/>
    <Value>
      <Calculation><![CDATA[Response.GetData]]></Calculation>
    </Value>
    <Name>$childData</Name>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text>&lt;&lt; More steps here if needed &gt;&gt;</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> Always end loop with Exit Loop If 1 (single pass loop)</Text>
  </Step>
  <Step enable="True" id="72" name="Exit Loop If">
    <DisableStepCollapsed state="False"/>
    <Calculation><![CDATA[1]]></Calculation>
  </Step>
  <Step enable="True" id="73" name="End Loop">
    <DisableStepCollapsed state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text>&lt;&lt; Here goes rest of the script &gt;&gt;</Text>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> ### CENTRALIZED ERROR LOGGING — ONCE AFTER THE LOOP ###</Text>
  </Step>
  <Step enable="True" id="68" name="If">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Calculation><![CDATA[Error.HasError]]></Calculation>
  </Step>
  <Step enable="True" id="164" name="Perform Script on Server">
    <WaitForCompletion state="False"/>
    <DisableStepCollapsed state="False"/>
    <Calculation><![CDATA[Error.Get]]></Calculation>
    <Script id="1330" name="(94000) Creeer foutmelding"/>
  </Step>
  <Step enable="True" id="70" name="End If">
    <DisableStepCollapsed state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> Exit the script. Response.Make returns the error object automatically and the result data when the parent uses Response.Capture.</Text>
  </Step>
  <Step enable="True" id="103" name="Exit Script">
    <DisableStepCollapsed state="False"/>
    <Calculation><![CDATA[Response.Make ( $data )]]></Calculation>
  </Step>
  <Step enable="True" id="89" name="# (comment)">
    <DisableStepCollapsed state="False"/>
    <Restore state="False"/>
    <Text> ### ### ### ### ### ### ### ###</Text>
  </Step>
</fmxmlsnippet>
