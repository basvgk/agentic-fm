<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="71" name="Loop">
    <Restore state="False"/>
    <FlushType value="Always"/>
  </Step>
</fmxmlsnippet>
<!-- FlushType value (the token FileMaker WRITES to XML): "Always" (default, flush all cached relationships) | "Min" (Script Workspace label "Minimum"; flush only one relationship away) | "Defer" (wait until loop exits to flush). The Script Workspace DISPLAYS "Minimum" but FileMaker serializes "Min" — confirmed against a live copy-out; do not emit the display label as the value. -->
<!-- Exit via Exit Loop If step or Go to Record/Request/Page with Exit after last option. -->
<!-- Requires a matching End Loop step. -->
<!-- See https://help.claris.com/en/pro-help/content/loop.html -->
